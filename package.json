{
  "name": "zoqo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:bdd": "pnpm --filter @zoqo/api test:bdd",
    "test:e2e": "pnpm --filter @zoqo/web test:e2e",
    "test:boundaries": "node scripts/assert-boundaries.cjs",
    "check:licenses": "node scripts/check-licenses.cjs",
    "check:no-saas": "node scripts/check-no-saas.cjs",
    "check:ports": "node scripts/check-ports.cjs",
    "seed": "pnpm --filter @zoqo/api seed",
    "compose:minimal": "node scripts/compose.cjs minimal"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
