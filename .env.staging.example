# Staging configuration. Copy to .env.staging on the staging host and replace
# every secret; nothing here is a usable default.
#
# This file is read by docker-compose.staging.yml. Variables written as
# ${NAME:?...} in that file have no default and the stack refuses to start
# without them, which is deliberate: a staging box with a guessable JWT secret
# is a production incident waiting for a copy-paste.

# The hostname staging answers on. Must resolve to this host before you apply
# the TLS overlay.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com

# Which images to run. CI publishes both on every push to main.
IMAGE_REGISTRY=ghcr.io/obaidulkabir/zoco
IMAGE_TAG=latest

# Generate with: openssl rand -base64 36
JWT_SECRET=
POSTGRES_USER=zoqo
POSTGRES_PASSWORD=
POSTGRES_DB=zoqo
# The API connects as zoqo_app, never the superuser: Postgres bypasses
# row-level security for superusers, which would disable tenant isolation.
APP_DB_PASSWORD=
BCRYPT_ROUNDS=12

MINIO_ROOT_USER=zoqo
MINIO_ROOT_PASSWORD=
S3_BUCKET=zoqo

# Must list the exact origin the browser uses, scheme included.
CORS_ORIGINS=https://staging.example.com
# Deliberately looser than the production 5. Each post-deploy journey run spends
# two attempts (register, verify) from one runner IP, and several deploys inside
# the same 15-minute window would otherwise trip the limiter and fail the smoke
# check for the wrong reason. The limit itself is covered by the ORG-AUTH-002
# BDD scenarios, which assert the real threshold in process.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000

# Staging traps mail in Mailpit and never delivers outbound.
MAILER_DRIVER=smtp
MAIL_FROM=noreply@staging.example.com

# Build-time only. The web image inlines this into the client bundle, so it is
# passed as a build argument in the deploy workflow rather than read from here.
NEXT_PUBLIC_API_URL=https://staging.example.com
