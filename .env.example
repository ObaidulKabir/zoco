# Copy to .env — working defaults, no vendor accounts (SYS-DEP-003)
# Host ports are checked before bind (`pnpm check:ports`). If a port is taken,
# change the * _PORT variable below (and any URL that includes that port).
COMPOSE_PROFILES=minimal

WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

POSTGRES_USER=zoqo
POSTGRES_PASSWORD=zoqo
POSTGRES_DB=zoqo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zoqo:zoqo@localhost:5432/zoqo

VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://zoqo:zoqo@localhost:5672
RABBITMQ_USER=zoqo
RABBITMQ_PASSWORD=zoqo

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=zoqo
S3_SECRET_KEY=zoqozoqozoqo
S3_BUCKET=zoqo
S3_FORCE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=noreply@zoqo.local

MINIO_ROOT_USER=zoqo
MINIO_ROOT_PASSWORD=zoqozoqozoqo

TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

LIVEKIT_PORT=7880
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecre

TURN_PORT=3478
TURN_HOST=localhost
TURN_REALM=zoqo.local
TURN_STATIC_AUTH_SECRET=turnsecret

LIBRETRANSLATE_PORT=5000
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=local
TRANSLATION_DRIVER=libretranslate
JWT_SECRET=dev-only-change-me
BCRYPT_ROUNDS=12
MAILER_DRIVER=smtp

PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
LOKI_PORT=3101
GLITCHTIP_PORT=8000
UPTIME_KUMA_PORT=3003

# VAPID generated locally in Sprint 10 — placeholders only
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@zoqo.local
